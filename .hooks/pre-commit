#!/usr/bin/env bash
# Pre-commit hook: run the project formatter check on tracked Julia files.
# Delegates to devtools/format.jl — the same pinned script CI runs — so local
# commits and CI never disagree on formatting.
#
# To skip (e.g. WIP commits):
#   git commit --no-verify

set -euo pipefail

# Only run if there are staged Julia files
if ! git diff --cached --name-only | grep -qE '\.jl$'; then
  exit 0
fi

echo "── JuliaFormatter check ──────────────────────────────────────────────"
exec julia devtools/format.jl --check
